#!/usr/bin/env bash
# ccx — chạy nhiều tài khoản Claude Code trên cùng một máy.
#
# Mỗi account là một thư mục cấu hình riêng (CLAUDE_CONFIG_DIR) dưới
# ~/.claude-accounts/<tên>/: credentials, lịch sử, settings tách biệt hoàn toàn,
# đăng nhập một lần, chạy song song nhiều terminal.
#
# CÁCH DÙNG
#   ccx add <tên>            tạo account rồi mở Claude Code để gõ /login
#   ccx ls                   bảng trạng thái (mặc định khi không có tham số)
#   ccx use <tên> [args…]    chạy Claude Code bằng account đó
#   ccx next [args…]         chọn account rảnh, lâu chưa dùng nhất
#   ccx limit <tên> [giờ]    đánh dấu đã chạm limit (mặc định 5 giờ)
#   ccx clear <tên>          xoá cooldown
#   ccx env <tên>            in các dòng export để eval
#   ccx rm <tên>             xoá account (phải gõ lại tên để xác nhận)
#
# Khi Claude Code thoát, ccx in session id vừa chạy kèm lệnh --resume.
#
# BIẾN MÔI TRƯỜNG
#   CCX_HOME        thư mục chứa account     (mặc định ~/.claude-accounts)
#   CCX_CLAUDE_BIN  lệnh Claude Code         (mặc định claude)
#   CCX_DANGER      1 = thêm --dangerously-skip-permissions (mặc định 1, 0 = tắt)

set -euo pipefail

CCX_HOME=${CCX_HOME:-"$HOME/.claude-accounts"}
CCX_CLAUDE_BIN=${CCX_CLAUDE_BIN:-claude}
CCX_DANGER=${CCX_DANGER:-1}
LEDGER="$CCX_HOME/ledger.tsv"   # <tên>	<epoch dùng cuối>	<epoch hết cooldown>

if [ -t 2 ]; then
    B=$'\033[1m' D=$'\033[2m' R=$'\033[31m' G=$'\033[32m' C=$'\033[36m' X=$'\033[0m'
else
    B='' D='' R='' G='' C='' X=''
fi

die() { printf '%sLỗi:%s %s\n' "$R" "$X" "$*" >&2; exit 1; }
now() { date +%s; }

init() {
    [ -d "$CCX_HOME" ] || { mkdir -p "$CCX_HOME"; chmod 700 "$CCX_HOME"; }
    [ -f "$LEDGER" ] || install -m 600 /dev/null "$LEDGER"
}

need() {
    case ${1:-} in
        '') die "thiếu tên account. Xem 'ccx --help'." ;;
        *[!a-zA-Z0-9_-]*) die "tên '$1' không hợp lệ — chỉ chữ, số, '-' và '_'." ;;
    esac
    [ -d "$CCX_HOME/$1" ] || die "không có account '$1'. Xem 'ccx ls'."
}

accounts() {
    local d
    init
    for d in "$CCX_HOME"/*/; do
        [ -d "$d" ] || continue
        d=${d%/}
        printf '%s\n' "${d##*/}"
    done
}

# ---------------------------------------------------------------- sổ ghi ---
# In "<dùng cuối> <hết cooldown>", mặc định "0 0".
get() {
    init
    awk -F'\t' -v n="$1" '$1 == n { l = $2; c = $3 } END { print l + 0, c + 0 }' "$LEDGER"
}

put() {
    local tmp
    init
    tmp=$(mktemp "$LEDGER.XXXXXX")
    awk -F'\t' -v n="$1" '$1 != n && NF' "$LEDGER" > "$tmp"
    [ $# -lt 3 ] || printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$LEDGER"
}

ago() {
    local s=$(( $(now) - $1 ))
    if [ "$1" -le 0 ]; then printf 'chưa dùng'
    elif [ "$s" -lt 3600 ]; then printf '%dp trước' "$(( s / 60 ))"
    elif [ "$s" -lt 86400 ]; then printf '%dh trước' "$(( s / 3600 ))"
    else printf '%d ngày trước' "$(( s / 86400 ))"
    fi
}

# ------------------------------------------------------------ chạy claude --
# Claude ghi sessions/<pid>.json (có sessionId) khi chạy và xoá khi thoát, nên
# phải đọc trong lúc chạy. /clear hay /resume đổi id → giữ id mới nhất.
watch_session() {
    local sdir=$1 pidfile=$2 out=$3 sid
    while sleep 1; do
        [ -s "$pidfile" ] || continue
        sid=$(grep -o '"sessionId":"[^"]*"' "$sdir/$(cat "$pidfile").json" 2>/dev/null | cut -d'"' -f4) || true
        [ -z "$sid" ] || printf '%s' "$sid" > "$out"
    done
}

run() {
    local name=$1 dir tmp watcher status=0 sid=''
    shift
    command -v "$CCX_CLAUDE_BIN" >/dev/null || die "không tìm thấy '$CCX_CLAUDE_BIN'. Cài Claude Code hoặc đặt CCX_CLAUDE_BIN."
    dir="$CCX_HOME/$name"
    export CLAUDE_CONFIG_DIR="$dir" CCX_ACCOUNT="$name"
    [ "$CCX_DANGER" = 0 ] || set -- --dangerously-skip-permissions "$@"

    tmp=$(mktemp -d)
    watch_session "$dir/sessions" "$tmp/pid" "$tmp/sid" &
    watcher=$!
    # Handler rỗng (không phải ignore): Ctrl+C không giết ccx, còn Claude được
    # reset về mặc định khi exec nên vẫn nhận Ctrl+C bình thường.
    trap ':' INT
    sh -c 'printf %s "$$" > "$1"; shift; exec "$@"' ccx "$tmp/pid" "$CCX_CLAUDE_BIN" "$@" || status=$?
    trap - INT
    kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    [ ! -s "$tmp/sid" ] || sid=$(cat "$tmp/sid")
    rm -rf -- "$tmp"

    if [ -n "$sid" ]; then
        printf '\n%ssession:%s %s%s%s\n' "$D" "$X" "$C" "$sid" "$X" >&2
        printf '%sresume:%s  ccx use %s --resume %s\n' "$D" "$X" "$name" "$sid" >&2
    fi
    exit "$status"
}

touch_used() {
    local last cool
    read -r last cool <<< "$(get "$1")"
    put "$1" "$(now)" "$cool"
}

# --------------------------------------------------------------- lệnh -----
cmd_add() {
    case ${1:-} in
        '') die "thiếu tên account." ;;
        *[!a-zA-Z0-9_-]*) die "tên '$1' không hợp lệ — chỉ chữ, số, '-' và '_'." ;;
    esac
    [ ! -d "$CCX_HOME/$1" ] || die "account '$1' đã tồn tại."
    init
    mkdir -m 700 "$CCX_HOME/$1"
    put "$1" 0 0
    printf '%sĐã tạo%s %s. Trong Claude Code gõ /login, xong thì /exit.\n' "$G" "$X" "$1" >&2
    run "$1"
}

cmd_ls() {
    local name last cool email state t
    t=$(now)
    if [ -z "$(accounts)" ]; then
        printf 'Chưa có account nào. Tạo: ccx add main\n'
        return
    fi
    {
        printf 'TÊN\tEMAIL\tDÙNG LẦN CUỐI\tTRẠNG THÁI\n'
        while read -r name; do
            read -r last cool <<< "$(get "$name")"
            email=$(grep -o '"emailAddress": *"[^"]*"' "$CCX_HOME/$name/.claude.json" 2>/dev/null \
                | head -n1 | cut -d'"' -f4) || true
            if [ "$cool" -gt "$t" ]; then
                state=$(printf 'limit, còn %dh%02dp' "$(( (cool - t) / 3600 ))" "$(( (cool - t) % 3600 / 60 ))")
            else
                state='sẵn sàng'
            fi
            printf '%s\t%s\t%s\t%s\n' "$name" "${email:--}" "$(ago "$last")" "$state"
        done < <(accounts)
    } | column -t -s $'\t'
}

cmd_use() {
    need "${1:-}"
    touch_used "$1"
    printf '%s→ %s%s\n' "$D" "$1" "$X" >&2
    run "$@"
}

cmd_next() {
    local name last cool best='' best_last=0 t
    t=$(now)
    while read -r name; do
        read -r last cool <<< "$(get "$name")"
        [ "$cool" -le "$t" ] || continue
        if [ -z "$best" ] || [ "$last" -lt "$best_last" ]; then
            best=$name best_last=$last
        fi
    done < <(accounts)
    if [ -z "$best" ]; then
        cmd_ls >&2
        die "không có account nào rảnh. Chờ hết cooldown hoặc 'ccx clear <tên>'."
    fi
    printf '%s→ %s%s%s\n' "$D" "$B" "$best" "$X" >&2
    touch_used "$best"
    run "$best" "$@"
}

cmd_limit() {
    local hours=${2:-5} last cool until
    need "${1:-}"
    [[ $hours =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "số giờ '$hours' không hợp lệ."
    read -r last cool <<< "$(get "$1")"
    until=$(awk -v n="$(now)" -v h="$hours" 'BEGIN { printf "%d", n + h * 3600 }')
    put "$1" "$last" "$until"
    printf '%s nghỉ tới %s.\n' "$1" "$(date -d "@$until" '+%H:%M %d/%m')"
}

cmd_clear() {
    local last cool
    need "${1:-}"
    read -r last cool <<< "$(get "$1")"
    put "$1" "$last" 0
    printf '%s sẵn sàng.\n' "$1"
}

cmd_env() {
    need "${1:-}"
    printf 'export CLAUDE_CONFIG_DIR=%q\nexport CCX_ACCOUNT=%q\n' "$CCX_HOME/$1" "$1"
}

cmd_rm() {
    local answer=''
    need "${1:-}"
    printf '%sXoá vĩnh viễn%s %s (credentials + lịch sử). Gõ lại tên để xác nhận: ' "$R" "$X" "$CCX_HOME/$1"
    read -r answer || true
    [ "$answer" = "$1" ] || die "không khớp — không xoá gì."
    rm -rf -- "${CCX_HOME:?}/$1"
    put "$1"
    printf 'Đã xoá %s.\n' "$1"
}

cmd_help() {
    sed -n '2,/^[^#]/{/^#/{s/^# \{0,1\}//;p}}' "${BASH_SOURCE[0]}"
}

cmd=${1:-ls}
[ $# -eq 0 ] || shift
case $cmd in
    add)            cmd_add "$@" ;;
    ls|list)        cmd_ls ;;
    use)            cmd_use "$@" ;;
    next)           cmd_next "$@" ;;
    limit)          cmd_limit "$@" ;;
    clear)          cmd_clear "$@" ;;
    env)            cmd_env "$@" ;;
    rm|remove)      cmd_rm "$@" ;;
    -h|--help|help) cmd_help ;;
    *) die "lệnh không hợp lệ: $cmd. Xem 'ccx --help'." ;;
esac
